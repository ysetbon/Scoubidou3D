node_modules/
dist/
.DS_Store
*.local
.vite/

# artifact build scratch (see artifacts/README.md)
artifacts/*/.work/

# the bundle worker-api's offline test runs (see worker-api/test/api-check.mjs)
worker-api/.work/

# Python bytecode, wherever it lands. Seven scripts put public/mxn/py on
# sys.path and import from it, so a fixture run writes a __pycache__ there too;
# naming one directory is exactly what let public/mxn/py/__pycache__ get
# committed. Nothing here can load it either way — the workers fetch the .py
# files by name, and Pyodide is CPython 3.14 against cpython-311 bytecode.
__pycache__/

# npm writes one here on any `npm install` in worker-api/; the project has
# never tracked it, and a diagnostic run should not be the thing that starts.
worker-api/package-lock.json
