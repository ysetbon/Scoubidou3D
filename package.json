{
  "name": "scoubidou3d",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A 3D reimagining of OpenStrand Studio: strands are ribbons with real width AND thickness, stacked layer-over-layer along Z and viewable from any angle. Reads OpenStrand Studio / OpenStrandJS .json files.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "probe:turn": "esbuild scripts/probe-turn-ceiling.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/probe-turn.mjs --log-level=warning && node node_modules/.cache/probe-turn.mjs",
    "check:history": "esbuild scripts/check-history.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-history.mjs --log-level=warning && node node_modules/.cache/check-history.mjs",
    "check:colour": "esbuild scripts/check-colour.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-colour.mjs --log-level=warning && node node_modules/.cache/check-colour.mjs",
    "check:twofan": "esbuild scripts/check-twofan.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-twofan.mjs --log-level=warning && node node_modules/.cache/check-twofan.mjs",
    "check:swirl": "esbuild scripts/check-swirl.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-swirl.mjs --log-level=warning && node node_modules/.cache/check-swirl.mjs",
    "check:trace": "esbuild scripts/check-trace-layout.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-trace-layout.mjs --log-level=warning && node node_modules/.cache/check-trace-layout.mjs",
    "check:census": "esbuild scripts/check-census.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-census.mjs --log-level=warning && node node_modules/.cache/check-census.mjs",
    "check:box": "esbuild scripts/check-box.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-box.mjs --log-level=warning && node node_modules/.cache/check-box.mjs",
    "art": "esbuild scripts/sample-art.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sample-art.mjs --log-level=warning && node node_modules/.cache/sample-art.mjs",
    "qa:trace": "node scripts/qa-trace-widget.mjs",
    "qa:semi": "node scripts/qa-semi-sort.mjs",
    "qa:widgets": "node scripts/qa-widgets.mjs",
    "shots": "node scripts/site-shots.mjs",
    "icon": "node scripts/icon-shot.mjs",
    "artifact": "node artifacts/build.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.169.0"
  }
}
